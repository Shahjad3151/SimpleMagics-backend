# SimpleMagics Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
#DATABASE_URL=postgresql://postgres:Azad%4012345@localhost:5432/simplemagic

# Security — MUST CHANGE in production (minimum 32 characters)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# Token expiry (in minutes) — default 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — add your frontend domain in production
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Optional: for server-side AI features
ANTHROPIC_API_KEY=

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
